<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.zai.devdashd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ABSOLUTE_VENV__/bin/zai-devdashd</string>
    <string>--config</string><string>__ABSOLUTE_CONFIG__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__PRIVATE_STATE__/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>__PRIVATE_STATE__/logs/stderr.log</string>
</dict>
</plist>
